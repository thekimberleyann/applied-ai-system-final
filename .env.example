# VibeFinder live-mode configuration (template).
#
# Copy this file to ".env" (same folder) and put your real key after the "=".
# The real .env is gitignored and never committed; this .example is the tracked
# template so anyone running the project knows what to set.
#
# Leaving this unset is fine: VibeFinder runs fully offline and deterministic
# without a key. A key only enables the LIVE Gemini explanation path.

GEMINI_API_KEY=your_key_here
